DATABASE_URL=postgresql+psycopg://ai_security:ai_security_dev@localhost:5432/ai_security
REDIS_URL=redis://localhost:6379/0

# DeepSeek SAST multi-agent. Keep the real key only in apps/api/.env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
# Structured JSON is more reliable and faster in non-thinking mode. Set true only if you accept higher latency/cost.
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=2

# DeepSeek for DAST business-flow drafts. Use a newly issued, separate key.
# Do not commit the real value. The DAST draft endpoint never receives cookies,
# tokens, passwords, raw responses, screenshots, or personal data.
DAST_DEEPSEEK_API_KEY=
DAST_DEEPSEEK_BASE_URL=https://api.deepseek.com
DAST_DEEPSEEK_MODEL=deepseek-v4-flash
DAST_DEEPSEEK_THINKING_ENABLED=false
DAST_DEEPSEEK_TIMEOUT_SECONDS=60
DAST_DEEPSEEK_MAX_RETRIES=1

# SANDBOX may pull only the fixed official runtime allowlist used by a locally
# validated launch plan. Arbitrary project-provided image names are never pulled.
SANDBOX_EXECUTOR_IMAGE=python:3.12-slim
# The fixed browser evidence adapter becomes ready when this exact Playwright
# image exists locally. It enforces same-origin/path routing and fixed actions.
SANDBOX_BROWSER_IMAGE=ai-security-platform/playwright-python:1.54.0
