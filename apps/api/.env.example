DATABASE_URL=postgresql+psycopg://ai_security:ai_security_dev@localhost:5432/ai_security
REDIS_URL=redis://localhost:6379/0

# DeepSeek SAST multi-agent. Keep the real key only in apps/api/.env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
# Structured JSON is more reliable and faster in non-thinking mode. Set true only if you accept higher latency/cost.
DEEPSEEK_THINKING_ENABLED=false
DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=2
