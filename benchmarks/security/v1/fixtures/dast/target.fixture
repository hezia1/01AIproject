"""Disposable localhost-only DAST benchmark target; never deploy this fixture."""
from __future__ import annotations

from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
import os


MODE = os.getenv("DAST_FIXTURE_MODE", "safe")


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        if self.path == "/health":
            return self.respond(200, {"status": "ready"})
        if self.path == "/headers":
            return self.respond(200, {"mode": MODE})
        self.respond(404, {"error": "not found"})

    def do_POST(self) -> None:
        if self.path != "/calculate":
            return self.respond(404, {"error": "not found"})
        try:
            payload = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)))
            expression = str(payload.get("expression") or "")
        except (json.JSONDecodeError, AttributeError):
            return self.respond(400, {"error": "invalid request"})
        if MODE == "vulnerable":
            try:
                result = eval(expression, {"__builtins__": {}}, {})  # deliberate fixture
            except Exception:
                return self.respond(400, {"error": "invalid expression"})
            return self.respond(200, {"result": result})
        if not expression.isdecimal():
            return self.respond(400, {"error": "integer required"})
        self.respond(200, {"result": int(expression)})

    def respond(self, status: int, payload: dict[str, object]) -> None:
        body = json.dumps(payload).encode()
        self.send_response(status)
        if MODE == "vulnerable":
            self.send_header("X-Powered-By", "benchmark-fixture")
        else:
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy", "default-src 'none'")
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *_args: object) -> None:
        return None


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
